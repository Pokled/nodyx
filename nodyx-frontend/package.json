{
  "name": "nodyx-frontend",
  "private": true,
  "version": "2.12.0",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "i18n:scan": "node scripts/i18n/scan.mjs",
    "i18n:coverage": "node scripts/i18n/coverage.mjs",
    "i18n:keys": "node scripts/i18n/check-keys.mjs",
    "i18n:keys:check": "node scripts/i18n/check-keys.mjs --check",
    "i18n:placeholders": "node scripts/i18n/check-placeholders.mjs",
    "i18n:placeholders:check": "node scripts/i18n/check-placeholders.mjs --check --quiet",
    "i18n:parity:check": "node scripts/i18n/coverage.mjs --require en",
    "i18n:public:check": "node scripts/i18n/scan.mjs --public --check",
    "i18n:check": "node scripts/i18n/scan.mjs --check",
    "i18n:ts": "node scripts/i18n/scan.mjs --ts --list",
    "i18n:ts:check": "node scripts/i18n/scan.mjs --ts --check",
    "i18n:ts:baseline": "node scripts/i18n/scan.mjs --ts --baseline",
    "icons:bundle": "node scripts/icons/bundle-hugeicons.mjs",
    "test:responsive": "playwright test",
    "test:responsive:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@iconify-json/hugeicons": "^1.2.33",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.2",
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@resvg/resvg-js": "2.6.2",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-character-count": "3.30.5",
    "@tiptap/extension-code-block-lowlight": "3.30.5",
    "@tiptap/extension-color": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-table-cell": "3.30.5",
    "@tiptap/extension-table-header": "3.30.5",
    "@tiptap/extension-table-row": "3.30.5",
    "@tiptap/extension-text-align": "3.30.5",
    "@tiptap/extension-text-style": "3.30.5",
    "@tiptap/extension-underline": "3.30.5",
    "@tiptap/extension-youtube": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "lowlight": "3.3.0",
    "lucide-svelte": "1.0.1",
    "mediasoup-client": "3.23.1",
    "qrcode": "1.5.4",
    "satori": "0.33.4",
    "socket.io-client": "4.8.3"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "esbuild": "^0.28.1"
  }
}
